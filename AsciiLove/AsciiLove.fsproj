<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CONTRIBUTING.MD" />
    <None Include="paket.references" />
    <Content Include="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Include="Config.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Global.fs" />
    <Compile Include="GitDomain.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="RepoStatus.fs" />
    <Compile Include="Screens\MVU.fs" />
    <Compile Include="Screens\GitStatusScreen.fs" />
    <Compile Include="Screens\SettingsScreen.fs" />
    <Compile Include="Screens\HelpScreen.fs" />
    <Compile Include="Screens\GalleryScreen.fs" />
    <Compile Include="Screens\MainScreen.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleMVU.Contracts\ConsoleMVU.Contracts.fsproj" />
    <ProjectReference Include="..\ConsoleMVU.Runtime\ConsoleMVU.Runtime.fsproj" />
    <ProjectReference Include="..\..\..\Starly\Atomic.Operators\Atomic.Operators\Atomic.Operators.fsproj" />
    <ProjectReference Include="..\git-status-cache-dotnet\git-status-cache-dotnet.fsproj" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>